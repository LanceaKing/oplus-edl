+        Output::Accept(3),
+        Output::Accept(2),
+    ]);
+    program(&mut dev).unwrap();
+    assert!(trace.lock().unwrap().accepted.ends_with(b"abcdefgh"));
+    assert_eq!(trace.lock().unwrap().writes.len(), 4);
+}
